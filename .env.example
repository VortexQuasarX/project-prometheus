APP_ENV=local
API_HOST=0.0.0.0
API_PORT=8000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
LLM_PROVIDER=mock
EMBEDDING_PROVIDER=mock
VECTOR_STORE_PROVIDER=local
CACHE_PROVIDER=local
DATABASE_URL=sqlite:///./prometheus.db
REDIS_URL=
CACHE_SIMILARITY_THRESHOLD=0.82
CACHE_TTL_SECONDS=3600
DEFAULT_MODEL=mock-small
STRONG_MODEL=mock-large
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
# --- Real LLM mode (OpenAI-compatible): set LLM_PROVIDER=openai + key ---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_CHEAP_MODEL=gpt-4o-mini
# OPENAI_STRONG_MODEL=gpt-4o
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
ADMIN_API_KEY=***
LOG_LEVEL=INFO
DAILY_BUDGET_USD=2.0
REQUEST_BUDGET_USD=0.05

# SERVER_API_URL=http://localhost:8000
# CORS_ORIGINS=http://localhost:3000
# IDEMPOTENCY_TTL_SECONDS=600
# BUDGET_WARNING_RATIO=0.7
# BUDGET_CRITICAL_RATIO=0.9
# MOCK_LATENCY_CHEAP_MS=100
# MOCK_LATENCY_STRONG_MS=500
# CACHE_VERSION=v1
# EXPENSIVE_MODELS=mock-large,bedrock-strong
